{
  "name": "Telisik: search the sources",
  "short_name": "Telisik",
  "description": "Ask 23 public sources at once, straight from your browser: Wikipedia and its sister projects, Stack Exchange, Hacker News, GitHub, OpenAlex, Europe PMC, the Internet Archive, an open web index and government records. No generated text, no ads, no account.",
  "lang": "en",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fbfbf8",
  "theme_color": "#16181d",
  "categories": ["education", "productivity", "utilities"],
  "shortcuts": [
    { "name": "New search", "url": "./", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Operators and shortcuts", "url": "about.html#operators", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "How it works", "url": "about.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "text": "q", "title": "title" }
  },
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
