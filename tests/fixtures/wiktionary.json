 "en": [
  {
   "partOfSpeech": "Noun",
   "language": "English",
   "definitions": [
    {
     "definition": ""
    },
    {
     "definition": "A <a rel=\"mw:WikiLink\" href=\"/wiki/perennial\" title=\"perennial\">perennial</a> <a rel=\"mw:WikiLink\" href=\"/wiki/woody\" title=\"woody\">woody</a> <a rel=\"mw:WikiLink\" href=\"/wiki/plant\" title=\"plant\">plant</a> taller and larger than a <a rel=\"mw:WikiLink\" href=\"/wiki/shrub\" title=\"shrub\">shrub</a> with a wooden trunk and, at some distance from the ground, having leaves and branches.",
     "parsedExamples": [
      {
       "example": "Hyperion is the tallest living <b>tree</b> in the world."
      },
      {
       "example": "Birds have a nest in a <b>tree</b> in the garden."
      }
     ],
     "examples": [
      "Hyperion is the tallest living <b>tree</b> in the world.",
      "Birds have a nest in a <b>tree</b> in the garden."
     ]
    },
    {
     "definition": "Any other <a rel=\"mw:WikiLink\" href=\"/wiki/plant\" title=\"plant\">plant</a> (such as a large shrub or herb) that is <a rel=\"mw:WikiLink\" href=\"/wiki/reminiscent\" title=\"reminiscent\">reminiscent</a> of the above in form and size.",
     "parsedExamples": [
      {
       "example": "The banana <b>tree</b> is a tall perennial herb<span typeof=\"mw:Entity\">:</span> its trunk is not woody."
      }
     ],
     "examples": [
      "The banana <b>tree</b> is a tall perennial herb<span typeof=\"mw:Entity\">:</span> its trunk is not woody."
     ]
    },
    {
     "definition": "An object made from a tree trunk and having multiple <a rel=\"mw:WikiLink\" href=\"/wiki/hook\" title=\"hook\">hooks</a> or storage <a rel=\"mw:WikiLink\" href=\"/wiki/platform\" title=\"platform\">platforms</a>.",
     "parsedExamples": [
      {
       "example": "He had the choice of buying a scratching post or a cat <b>tree</b>."
      }
     ],
     "examples": [
      "He had the choice of buying a scratching post or a cat <b>tree</b>."
     ]
    },
    {
     "definition": "A device used to hold or stretch a shoe open.",
     "parsedExamples": [
      {
       "example": "He put a shoe <b>tree</b> in each of his shoes."
      }
     ],
     "examples": [
      "He put a shoe <b>tree</b> in each of his shoes."
     ]
    },
    {
     "definition": "The structural <a rel=\"mw:WikiLink\" href=\"/wiki/frame\" title=\"frame\">frame</a> of a <a rel=\"mw:WikiLink\" href=\"/wiki/saddle\" title=\"saddle\">saddle</a>."
    },
    {
     "definition": "<span class=\"usage-label-sense\" about=\"#mwt114\" typeof=\"mw:Transclusion\"></span> A connected <a rel=\"mw:WikiLink\" href=\"/wiki/graph\" title=\"graph\">graph</a> with no cycles or, if the graph is finite, equivalently a connected graph with <i>n</i> vertices and <i>n</i>−1 edges."
    },
    {
     "definition": "<span class=\"usage-label-sense\" about=\"#mwt115\" typeof=\"mw:Transclusion\"></span> A <a rel=\"mw:WikiLink\" href=\"/wiki/recursive\" title=\"recursive\">recursive</a> <a rel=\"mw:WikiLink\" href=\"/wiki/data_structure\" title=\"data structure\">data structure</a> in which each <a rel=\"mw:WikiLink\" href=\"/wiki/node\" title=\"node\">node</a> has zero or more nodes as children, but does not share children with other nodes."
    },
    {
     "definition": "<span class=\"usage-label-sense\" about=\"#mwt116\" typeof=\"mw:Transclusion\"></span> A <a rel=\"mw:WikiLink\" href=\"/wiki/display\" title=\"display\">display</a> or listing of <a rel=\"mw:WikiLink\" href=\"/wiki/entry\" title=\"entry\">entries</a> or <a rel=\"mw:WikiLink\" href=\"/wiki/element\" title=\"element\">elements</a> such that there are <a rel=\"mw:WikiLink\" href=\"/wiki/primary\" title=\"primary\">primary</a> and <a rel=\"mw:WikiLink\" href=\"/wiki/secondary\" title=\"secondary\">secondary</a> entries shown, usually linked by drawn lines or by indenting to the right.",
     "parsedExamples": [
      {
       "example": "We’ll show it as a <b>tree</b> list."
      }
     ],
     "examples": [
      "We’ll show it as a <b>tree</b> list."
     ]
    },
    {
     "definition": "Any <a rel=\"mw:WikiLink\" href=\"/wiki/structure\" title=\"structure\">structure</a> or <a rel=\"mw:WikiLink\" href=\"/wiki/construct\" title=\"construct\">construct</a> having <a rel=\"mw:WikiLink\" href=\"/wiki/branch\" title=\"branch\">branches</a> representing <a rel=\"mw:WikiLink\" href=\"/wiki/divergence\" title=\"divergence\">divergence</a> or possible <a rel=\"mw:WikiLink\" href=\"/wiki/choice\" title=\"choice\">choices</a>.",
     "parsedExamples": [
      {
       "example": "<a rel=\"mw:WikiLink\" href=\"/wiki/family_tree#English\" title=\"family tree\">family <b>tree</b></a><span typeof=\"mw:Entity\">;</span> <a rel=\"mw:WikiLink\" href=\"/wiki/skill_tree#English\" title=\"skill tree\">skill <b>tree</b></a>"
      }
     ],
     "examples": [
      "<a rel=\"mw:WikiLink\" href=\"/wiki/family_tree#English\" title=\"family tree\">family <b>tree</b></a><span typeof=\"mw:Entity\">;</span> <a rel=\"mw:WikiLink\" href=\"/wiki/skill_tree#English\" title=\"skill tree\">skill <b>tree</b></a>"
     ]
    },
    {
     "definition": ""
    },
    {
     "definition": "The <a rel=\"mw:WikiLink\" href=\"/wiki/structure\" title=\"structure\">structure</a> or <a rel=\"mw:WikiLink\" href=\"/wiki/wooden\" title=\"wooden\">wooden</a> <a rel=\"mw:WikiLink\" href=\"/wiki/frame\" title=\"frame\">frame</a> used in the construction of a <a rel=\"mw:WikiLink\" href=\"/wiki/saddle\" title=\"saddle\">saddle</a> used in horse riding."
    },
